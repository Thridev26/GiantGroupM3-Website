            <i class="bi bi-bar-chart-line me-1"></i>
            Reports
        </a>
    </li>
<% } %>


                    </ul>

                    <!-- Right-Hand Side: Search, Navigation, and Authentication -->
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-1 gap-lg-2 mt-3 mt-lg-0">

                        <!-- Minimalist Search Bar -->
                        <% if (IsLoggedIn()) { %>
                        <li class="nav-item gg-search" style="width: 200px;">
                            <div class="input-group input-group-sm rounded-pill overflow-hidden border border-light border-opacity-25" style="background: rgba(255,255,255,0.08);">
                                <input type="text" id="siteSearchInput" class="form-control form-control-sm bg-transparent text-white border-0 shadow-none px-3" placeholder="Search this page..." aria-label="Search this page" style="color: #fff !important;" />
                                <button class="btn btn-sm text-white border-0 px-2" type="button" id="siteSearchBtn" aria-label="Search" style="background: rgba(255,255,255,0.15);">
                                    <i class="bi bi-search small"></i>
                                </button>
                            </div>
                        </li>
                        <% } %>

                        <!-- More: FAQ, About and Contact grouped to free up space in the menu strip -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">More</a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item" runat="server" href="~/Help.aspx"><i class="bi bi-question-circle me-2"></i>FAQ</a>
                                <a class="dropdown-item" runat="server" href="~/About.aspx"><i class="bi bi-info-circle me-2"></i>About</a>
                                <a class="dropdown-item" runat="server" href="~/Contact.aspx"><i class="bi bi-envelope me-2"></i>Contact</a>
