                        </asp:LoginView>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Floating Chatbot Widget Window -->
        <div id="chatbotPopup" role="dialog" aria-label="Chat with Oak">
            <div class="oak-chat">

                <!-- Header -->
                <div class="oak-chat-head">
                    <button type="button" class="oak-chat-close" aria-label="Close chat" onclick="toggleChatbot()">&times;</button>
                    <img src="<%= ResolveUrl("~/Content/oak-icon.png") %>" alt="Oak" class="oak-chat-icon" id="oakHeaderIcon" />
                    <h6 class="fw-bold mb-0">Oak</h6>
                    <small style="opacity: .85;">Giant Group Assistant</small>
                </div>

                <!-- Messages -->
                <div class="oak-chat-body" id="chatBody" aria-live="polite">
                    <div class="d-flex mb-3">
                        <div class="p-3 bg-white rounded-3 shadow-sm text-dark small gg-bubble" style="max-width: 90%;">
                            Hi, I'm <strong>Oak</strong>, The Giant Group's virtual assistant. If you need anything, such as prices, opening hours, our services or how to reach us, just ask me.
                        </div>
                    </div>
                    <% if (!IsLoggedIn()) { %>
                    <div class="d-flex mb-3">
                        <div class="p-3 bg-white rounded-3 shadow-sm text-dark small gg-bubble" style="max-width: 90%;">
                            <i class="bi bi-lock me-1"></i>You're browsing as a guest. <strong>Log in or create an account</strong> to submit job requests, view quotes and access the rest of the website's features.
                            <div class="d-flex gap-2 mt-3">
                                <a href="<%= ResolveUrl("~/Account/Login.aspx") %>" class="btn btn-success btn-sm px-3" style="background-color: #2d6a4f !important; border: none;">Log In</a>
                                <a href="<%= ResolveUrl("~/Account/Register.aspx") %>" class="btn btn-outline-success btn-sm px-3">Create Account</a>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>

                <!-- Input -->
                <div class="oak-chat-foot">
                    <div class="input-group">
                        <input type="text" id="chatInput" class="form-control form-control-sm border-0 py-2 px-3" placeholder="Type your message..." aria-label="Message to Oak" autocomplete="off" />
                        <button class="btn btn-success px-3" type="button" style="background-color: #2d6a4f !important; border: none;" onclick="sendChatMessage()" aria-label="Send message"><i class="bi bi-send-fill"></i></button>
                    </div>
                </div>

            </div>
        </div>

        <!-- Main Content Area -->
        <div id="main-content" class="container body-content mt-4">
            <!-- Floating Guest Prompt Card -->
            <% if (!IsLoggedIn()) { %>
            <div id="guestNoticeCard" class="card shadow-lg border-0 position-fixed end-0 m-4 p-4 gg-notice">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="mb-0">Welcome to The Giant Group</h5>
                    <button type="button" class="gg-notice-close" aria-label="Close" onclick="dismissGuestCard()">&times;</button>
                </div>
                <p class="mb-0 small">You are currently browsing as a guest. To access management tools, view records, or perform actions, please <a href="~/Account/Login.aspx" runat="server" class="fw-bold text-success">Log In</a> or <a href="~/Account/Register.aspx" runat="server" class="fw-bold text-success">Register</a>.</p>
            </div>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    // On the home page, the hero slideshow decides when the card appears
                    if (document.getElementById("hero")) return;

                    var dismissed = false;
                    try { dismissed = !!sessionStorage.getItem("guestCardDismissed"); } catch (e) { }
                    if (!dismissed) {
                        var card = document.getElementById("guestNoticeCard");
                        if (card) card.style.display = "block";
                    }
                });

                // Function triggered when the X button is clicked
                function dismissGuestCard() {
                    var card = document.getElementById("guestNoticeCard");
                    if (card) {
                        card.style.display = "none";
                        try { sessionStorage.setItem("guestCardDismissed", "true"); } catch (e) { }
                    }
                }
            </script>
            <% } %>

            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <!-- Return to Portal: shown at the bottom of every logged-in page except the portals themselves -->
        <% if (ShowReturnToPortal()) { %>
        <div class="gg-return">
            <a class="gg-btn gg-btn-primary gg-return-btn" runat="server" href="~/HomeRouter.aspx">
                <i class="bi bi-arrow-left"></i>
                Return to Portal
            </a>
        </div>
        <% } %>

        <!-- Footer: full width, outside the container -->
        <footer class="gg-footer w-100">
            <div class="container">
                <div class="row align-items-center gy-3">

                    <!-- Left: Company & Team Branding -->
                    <div class="col-md-6 text-center text-md-start">
                        <p class="mb-1 fw-semibold small gg-footer-brand">
                            &copy; <%: DateTime.Now.Year %> The Giant Group &bull; Engineered by <span class="gg-footer-accent">Code Crusaders</span>
                        </p>
                        <p class="mb-0" style="font-size: 0.8rem;">
                            Enterprise Operations &amp; Asset Management System &bull; Last Updated: <span id="lastUpdatedDate" class="fw-medium text-white"></span>
                        </p>
                    </div>

                    <!-- Right: Quick Navigation, Legal Links & Socials -->
                    <div class="col-md-6 text-center text-md-end">
                        <div class="d-flex justify-content-center justify-content-md-end align-items-center gap-3 small flex-wrap">
                            <a runat="server" href="~/Default.aspx">Home</a>
                            <span class="gg-footer-sep">/</span>
                            <a runat="server" href="~/Help.aspx">Help Guide</a>
                            <span class="gg-footer-sep">/</span>
                            <a runat="server" href="~/Contact.aspx">Support</a>
                            <span class="gg-footer-sep">/</span>
                            <a runat="server" href="~/Privacy.aspx" class="fw-bold text-white">Privacy Policy</a>
                            <span class="gg-footer-sep">/</span>
                            <a href="https://wa.me/27848331373?text=Hello%20The%20Giant%20Group,%20I%20would%20like%20to%20inquire%20about%20your%20services." target="_blank" rel="noopener noreferrer" class="gg-social" title="WhatsApp" aria-label="WhatsApp">
                                <i class="bi bi-whatsapp"></i>
                            </a>
                            <a href="https://www.instagram.com/thegiantgroup_/" target="_blank" rel="noopener noreferrer" class="gg-social" title="Instagram" aria-label="Instagram">
                                <i class="bi bi-instagram"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </footer>
    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/bootstrap.js") %>
    </asp:PlaceHolder>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- AOS Animation JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script>
        // Record exact load time
        const loaderStartTime = Date.now();
        const MINIMUM_SHOW_TIME = 1400;

        AOS.init({
            duration: 700,
            once: true,
            disable: window.matchMedia('(prefers-reduced-motion: reduce)').matches
        });

        // Hide 3D Loader
        window.addEventListener('load', function () {
            const loader = document.getElementById('loader-wrapper');
            if (loader) {
                const elapsedTime = Date.now() - loaderStartTime;
                const remainingTime = Math.max(0, MINIMUM_SHOW_TIME - elapsedTime);

                setTimeout(() => {
                    loader.style.opacity = '0';
                    loader.style.pointerEvents = 'none';
                    setTimeout(() => {
                        loader.style.display = 'none';
                    }, 500);
                }, remainingTime);
            }
        });

        // Show loader on navigation (skips new-tab, download, mail/phone and external links so it can never get stuck)
        document.addEventListener('click', function (e) {
            const target = e.target.closest('a');
            if (!target) return;
            const rawHref = target.getAttribute('href');
            if (!rawHref || rawHref === '#' || rawHref.startsWith('#') || rawHref.startsWith('javascript') ||
                rawHref.startsWith('mailto:') || rawHref.startsWith('tel:')) return;
            if (target.classList.contains('dropdown-toggle')) return;
            if (target.target === '_blank' || target.hasAttribute('download')) return;
            if (e.ctrlKey || e.metaKey || e.shiftKey || e.button === 1) return;
            if (target.hostname && target.hostname !== window.location.hostname) return;
            if (target.href && !target.href.includes('#')) {
                const loader = document.getElementById('loader-wrapper');
                if (loader) {
                    loader.style.display = 'flex';
                    loader.style.opacity = '1';
                    loader.style.pointerEvents = 'auto';
                }
            }
        });

        // Global 3D Tilt Effect
        document.querySelectorAll('.tilt-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateX = -((y - centerY) / centerY) * 12;
                const rotateY = ((x - centerX) / centerX) * 12;

                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
            });

            card.addEventListener('mouseleave', () => {
                card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
                card.style.transition = 'transform 0.5s ease';
            });

            card.addEventListener('mouseenter', () => {
                card.style.transition = 'none';
            });
        });

        // --- UX FEATURES ---

        // 1. Dark Mode Toggle
        const darkModeToggle = document.getElementById('darkModeToggle');
        const darkModeIcon = document.getElementById('darkModeIcon');
        let currentTheme = null;
        try { currentTheme = localStorage.getItem('theme'); } catch (e) { }

        if (currentTheme === 'dark') {
            document.body.classList.add('dark-mode');
            if (darkModeIcon) darkModeIcon.className = 'bi bi-sun-fill small';
        }

        if (darkModeToggle) {
            darkModeToggle.addEventListener('click', () => {
                document.body.classList.toggle('dark-mode');
                let theme = 'light';

                if (document.body.classList.contains('dark-mode')) {
                    theme = 'dark';
                    if (darkModeIcon) darkModeIcon.className = 'bi bi-sun-fill small';
                } else {
                    if (darkModeIcon) darkModeIcon.className = 'bi bi-moon-fill small';
                }

                try { localStorage.setItem('theme', theme); } catch (e) { }
            });
        }

        // 2. Scroll Progress Bar & Back to Top Button
        const scrollProgress = document.getElementById('scroll-progress');
        const backToTopBtn = document.getElementById('backToTopBtn');

        window.addEventListener('scroll', () => {
            const totalHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
            if (scrollProgress) scrollProgress.style.width = progress + '%';

            if (backToTopBtn) {
                backToTopBtn.style.display = window.scrollY > 300 ? 'inline-flex' : 'none';
            }
        }, { passive: true });

        if (backToTopBtn) {
            backToTopBtn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // 3. Cookie Consent Banner Logic (Accept All / Reject Non-Essential)
        const cookieBanner = document.getElementById('cookieConsentBanner');
        const btnAccept = document.getElementById('btnAcceptCookies');
        const btnReject = document.getElementById('btnRejectCookies');

        function getCookie(name) {
            let match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            if (match) return match[2];
            return null;
        }

        function setConsent(value) {
            var secure = window.location.protocol === 'https:' ? '; Secure' : '';
            document.cookie = "GiantGroupCookieConsent=" + value + "; path=/; max-age=" + (60 * 60 * 24 * 365) + "; SameSite=Lax" + secure;
            if (cookieBanner) cookieBanner.style.display = 'none';
            document.body.classList.remove('has-cookie');
        }

        // Show banner if no choice has been recorded yet
        if (!getCookie("GiantGroupCookieConsent") && cookieBanner) {
            cookieBanner.style.display = 'block';
            document.body.classList.add('has-cookie');
        }
        if (btnAccept && cookieBanner) btnAccept.addEventListener('click', () => setConsent('Accepted'));
        if (btnReject && cookieBanner) btnReject.addEventListener('click', () => setConsent('Rejected'));

        // 4. Last Updated Date in Footer
        const lastUpdatedSpan = document.getElementById('lastUpdatedDate');
        if (lastUpdatedSpan) {
            lastUpdatedSpan.textContent = document.lastModified;
        }

        // 5. UTM Tracking Capture
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const utmSource = urlParams.get('utm_source');
            const utmMedium = urlParams.get('utm_medium');
            const utmCampaign = urlParams.get('utm_campaign');
            if (utmSource) {
                try {
                    localStorage.setItem('utm_source', utmSource);
                    localStorage.setItem('utm_medium', utmMedium || '');
                    localStorage.setItem('utm_campaign', utmCampaign || '');
                } catch (e) { }
            }
        });

        // 6. Site Search Quick Filter
        const searchBtn = document.getElementById('siteSearchBtn');
        const searchInput = document.getElementById('siteSearchInput');
        if (searchBtn && searchInput) {
            const performSearch = () => {
                const query = searchInput.value.trim().toLowerCase();
                if (query) {
                    if (window.find) {
                        window.find(query);
                    } else {
                        alert("Search query: " + query);
                    }
                }
            };
            searchBtn.addEventListener('click', performSearch);
            searchInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    performSearch();
                }
            });
        }

        // 7. Password Visibility Toggle: one eye button, styled by .gg-eye.
        // Fields already inside .gg-iconfield keep their layout. Other fields get a .gg-pw
        // wrapper so the eye sits inside the box. Fields with their own input-group toggle are left alone.
        document.querySelectorAll('input[type="password"]').forEach(passwordField => {
            let host = passwordField.parentNode;
            if (host.classList.contains('input-group') || host.querySelector('.gg-eye')) return;

            if (!host.classList.contains('gg-iconfield')) {
                const wrap = document.createElement('div');
                wrap.className = 'gg-pw';
                host.insertBefore(wrap, passwordField);
                wrap.appendChild(passwordField);
                host = wrap;
            }

            const eyeBtn = document.createElement('button');
            eyeBtn.type = 'button';
            eyeBtn.className = 'gg-eye';
            eyeBtn.title = 'Show or hide password';
            eyeBtn.setAttribute('aria-label', 'Show or hide password');
            eyeBtn.innerHTML = '<i class="bi bi-eye"></i>';
            host.appendChild(eyeBtn);

            eyeBtn.addEventListener('click', () => {
                const reveal = passwordField.type === 'password';
                passwordField.type = reveal ? 'text' : 'password';
                eyeBtn.innerHTML = '<i class="bi ' + (reveal ? 'bi-eye-slash' : 'bi-eye') + '"></i>';
            });
        });
    </script>

      <script>
          var OAK_ICONS = {
              happy: '<%= ResolveUrl("~/Content/oak-icon.png") %>',
            thinking: '<%= ResolveUrl("~/Content/oak-thinking.png") %>',
            confused: '<%= ResolveUrl("~/Content/oak-undecided.png") %>'
          };
          var CONTACT_URL = '<%= ResolveUrl("~/Contact.aspx") %>';
          var LOGIN_URL = '<%= ResolveUrl("~/Account/Login.aspx") %>';
        var REGISTER_URL = '<%= ResolveUrl("~/Account/Register.aspx") %>';
        var OAK_IS_GUEST = ('<%= IsLoggedIn() ? "false" : "true" %>' === 'true');
        var CHAT_URL = '<%= ResolveUrl("~/ChatHandler.ashx") %>';
        var oakHistory = [];
        var oakBusy = false;


        function toggleChatbot() {
            var chatPopup = document.getElementById("chatbotPopup");
            if (!chatPopup) return;
            if (chatPopup.style.display === "none" || chatPopup.style.display === "") {
                chatPopup.style.display = "block";
                var inp = document.getElementById("chatInput");
                if (inp) inp.focus();
            } else {
                chatPopup.style.display = "none";
            }
        }

        function openChatbot() {
            var notice = document.getElementById("guestNoticeCard");
            if (notice) notice.style.display = "none";
            var chatPopup = document.getElementById("chatbotPopup");
            if (chatPopup && (chatPopup.style.display === "none" || chatPopup.style.display === "")) {
                chatPopup.style.display = "block";
            }
        }

        function escapeHtml(text) {
            var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function (m) { return map[m]; });
        }

        function addOakMessage(html, mood) {
            var chatBody = document.getElementById("chatBody");
            var row = document.createElement("div");
            row.className = "d-flex align-items-start mb-3";
            row.innerHTML =
                '<img src="' + (OAK_ICONS[mood] || OAK_ICONS.happy) + '" alt="" class="me-2 flex-shrink-0" style="width: 36px; height: 36px; object-fit: contain;" />' +
                '<div class="p-3 bg-white rounded-3 shadow-sm text-dark small gg-bubble" style="max-width: 80%;">' + html + '</div>';
            chatBody.appendChild(row);
            chatBody.scrollTop = chatBody.scrollHeight;
            setOakMood(mood);
            return row;
            }

            function addOakText(text, mood) {
            var chatBody = document.getElementById("chatBody");
          var row = document.createElement("div");
          row.className = "d-flex align-items-start mb-3";
         var img = document.createElement("img");
        img.src = OAK_ICONS[mood] || OAK_ICONS.happy;
         img.alt = "";
         img.className = "me-2 flex-shrink-0";
         img.style.cssText = "width: 36px; height: 36px; object-fit: contain;";
         var bubble = document.createElement("div");
         bubble.className = "p-3 bg-white rounded-3 shadow-sm text-dark small gg-bubble";
         bubble.style.maxWidth = "80";
          bubble.style.whiteSpace = "pre-wrap";
          bubble.textContent = text;
          row.appendChild(img);
           row.appendChild(bubble);
          chatBody.appendChild(row);
          chatBody.scrollTop = chatBody.scrollHeight;
           setOakMood(mood);
       }

       function sendChatMessage() {

          var input = document.getElementById("chatInput");
         var chatBody = document.getElementById("chatBody");
         var userText = input.value.trim();
            if (userText === "" || oakBusy) return;

          var userMsgDiv = document.createElement("div");
          userMsgDiv.className = "d-flex justify-content-end mb-3";
          userMsgDiv.innerHTML = '<div class="p-3 bg-success text-white rounded-3 shadow-sm small gg-bubble" style="max-width: 80%;">' + escapeHtml(userText) + '</div>';
          chatBody.appendChild(userMsgDiv);
          input.value = "";
          chatBody.scrollTop = chatBody.scrollHeight;

         oakBusy = true;
         var thinkingRow = addOakMessage('<span class="oak-dots"><span></span><span></span><span></span></span>', 'thinking');

         var controller = ('AbortController' in window) ? new AbortController() : null;
         var timer = setTimeout(function () { if (controller) controller.abort(); }, 45000);

          fetch(CHAT_URL, {
           method: 'POST',
            headers: { 'Content-Type': 'application/json' },
           credentials: 'same-origin',
           body: JSON.stringify({ message: userText, history: oakHistory.slice(-6),page:location.pathname }),
           signal: controller ? controller.signal : undefined
        })
           .then(function (r) { return r.json(); })
           .then(function (data) {
         clearTimeout(timer);
          thinkingRow.remove();
          if (data && data.ok && data.reply) {
            addOakText(data.reply, data.mood || 'happy');
            oakHistory.push({ role: 'user', text: userText }, { role: 'model', text: data.reply });
            if (oakHistory.length > 12) oakHistory = oakHistory.slice(-12);
        } else if (data && data.reason === 'limit') {
            addOakText("I'm getting a lot of questions right now. Please try again in a few minutes, or call us on 0848 331 373.", 'confused');
        } else {
            fallbackReply(userText);
        }
    })
    .catch(function () {
        clearTimeout(timer);
        thinkingRow.remove();
        fallbackReply(userText);
    })
    .then(function () { oakBusy = false; });
}
        function fallbackReply(userText) {
            var reply = getSmartFAQResponse(userText);
            if (reply) {
            addOakMessage(reply, 'happy');
           } else if (OAK_IS_GUEST) {
            addOakMessage(
            "Sorry, to access me fully, please " +
            '<a href="' + LOGIN_URL + '" class="fw-bold text-success">log in</a> or ' +
            '<a href="' + REGISTER_URL + '" class="fw-bold text-success">create an account</a>.',
            'confused');
           } else {
            addOakMessage(
            "Sorry, I'm not sure about that one. You can call our team on <strong>0848 331 373</strong> or " +
            '<a href="' + CONTACT_URL + '" class="fw-bold text-success">send us a message on our Contact page</a>, and we will help you.',
            'confused');
    }
}

        // Press Enter to send
        (function () {
            var inp = document.getElementById("chatInput");
            if (inp) inp.addEventListener("keydown", function (e) {
                if (e.key === "Enter") { e.preventDefault(); sendChatMessage(); }
            });
        })();

        function getSmartFAQResponse(input) {
            var text = input.toLowerCase();
            if (text.includes('cost') || text.includes('rate') || text.includes('price') || text.includes('quote')) {
                return "Our pricing depends on the size and complexity of the tree-felling job. Contact us for a free on-site quote!";
            } else if (text.includes('hours') || text.includes('open') || text.includes('time') || text.includes('working')) {
                return "We operate Monday to Saturday, from 7:00 AM to 5:00 PM.";
            } else if (text.includes('contact') || text.includes('phone') || text.includes('call') || text.includes('email')) {
                return "You can reach us directly via our Contact page or call our support line at 0848 331 373.";
            } else if (text.includes('service') || text.includes('tree') || text.includes('felling') || text.includes('garden')) {
                return "We specialise in professional tree-felling, stump removal, site clearance, and general garden maintenance.";
            }
            return null;
        }

        var oakMoodTimer = null;

          function setOakMood(mood) {
           var icon = document.getElementById("oakHeaderIcon");
             if (!icon || !OAK_ICONS[mood]) return;
             icon.src = OAK_ICONS[mood];
        icon.classList.toggle("is-thinking", mood === 'thinking');

    clearTimeout(oakMoodTimer);
    if (mood === 'confused') {
        // after a few seconds, go back to the happy face
        oakMoodTimer = setTimeout(function () { setOakMood('happy'); }, 6000);
    }
}

// load all the faces now so there's no flicker when they swap
for (var m in OAK_ICONS) { new Image().src = OAK_ICONS[m]; }
      </script>
    <script>
        window.addEventListener('pageshow', function (event) {
            // If the page was loaded from the browser cache (back/forward button), hide the loader immediately
            if (event.persisted) {
                var loader = document.getElementById('loader-wrapper') || document.querySelector('.loader');
                if (loader) {
                    loader.style.display = 'none';
                }
            }
        });
    </script>

    <!-- Vanilla-Tilt 3D Library for Interactive Cursor Tracking -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
</body>
</html>
