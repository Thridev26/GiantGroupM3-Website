                                <a class="dropdown-item" runat="server" href="~/AssignStaff.aspx"><i class="bi bi-person-plus me-2"></i>Assign Staff to Job</a>
                                <% } %>
                            </div>
                        </li>
                        <% } %>

                      

                        <!-- ================= JOBS TAB ================= -->
                        <% if (CanSeeJobsTab() &&
                              (IsClient() || CanSeeAddEditJobDetails())) { %>

