            <a href="~/Privacy.aspx" runat="server" class="text-success text-decoration-underline ms-1">Learn more</a>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <button type="button" id="btnRejectCookies" class="btn btn-outline-light btn-sm px-3">Reject Non-Essential</button>
            <button type="button" id="btnAcceptCookies" class="btn btn-success btn-sm px-4 fw-bold">Accept All</button>
        </div>
    </div>
</div>
