                        <!-- Clients Tab -->
                        <% if (CanSeeClientsTab() && !IsOwner()) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Clients</a>
                            <div class="dropdown-menu">
                                <h6 class="dropdown-header">Actions</h6>
                                <a class="dropdown-item" runat="server" href="~/ClientProfile.aspx"><i class="bi bi-person-gear me-2"></i>Update Client Info</a>

                            </div>
                        </li>
                        <% } %>

                        <!-- Job Requests Tab -->
                        <% if (CanSeeJobRequestsTab() && !IsOwner()) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Job Requests</a>
                            <div class="dropdown-menu">
                                <h6 class="dropdown-header">Actions</h6>
                                <a class="dropdown-item" runat="server" href="~/Requests/SubmitRequest.aspx"><i class="bi bi-file-earmark-plus me-2"></i>Submit Job Request</a>
                                <a class="dropdown-item" runat="server" href="~/Requests/ViewRequests.aspx"><i class="bi bi-file-earmark-text me-2"></i>Update Job Requests</a>
                                <div class="dropdown-divider my-1"></div>
                                <h6 class="dropdown-header">Media</h6>
                                <a class="dropdown-item" runat="server" href="~/Requests/ViewRequests.aspx"><i class="bi bi-camera me-2"></i>Add Site Photos</a>
                            </div>
