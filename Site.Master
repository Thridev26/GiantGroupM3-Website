<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="GiantGroupM3.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - The Giant Group</title>
    
    <!-- Meta Description for SEO and Link Sharing -->
    <meta name="description" content="The Giant Group enterprise management platform. Powered by Code Crusaders for professional tree-felling operations, quoting, and asset management." />

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link rel="shortcut icon" href="~/Content/New Giant Tree Icon (1).ico" type="image/x-icon" />
    
    <!-- AOS Animation CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <!-- 3D Effects & Loader Styling -->
    <style>
        /* Loader Styles */
        #loader-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #40916c;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.5s ease;
        }

        #loader-wrapper p {
            color: #ffffff;
            font-family: sans-serif;
            margin-top: 30px;
            letter-spacing: 1px;
            font-weight: 500;
        }

        /* 3D Rotating Cube Loader */
        .cube-loader {
            perspective: 800px;
        }

        .cube {
            width: 60px;
            height: 60px;
            position: relative;
            transform-style: preserve-3d;
            animation: spinCube 2s infinite linear;
        }

        .face {
            position: absolute;
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.15);
            border: 2px solid #ffffff;
        }

        .front  { transform: translateZ(30px); }
        .back   { transform: rotateY(180deg) translateZ(30px); }
        .left   { transform: rotateY(-90deg) translateZ(30px); }
        .right  { transform: rotateY(90deg) translateZ(30px); }
        .top    { transform: rotateX(90deg) translateZ(30px); }
        .bottom { transform: rotateX(-90deg) translateZ(30px); }

        @keyframes spinCube {
            0% { transform: rotateX(0deg) rotateY(0deg); }
            100% { transform: rotateX(360deg) rotateY(360deg); }
        }

        /* Universal 3D Tilt Card Class */
        .tilt-card {
            transform-style: preserve-3d;
            transform: perspective(1000px);
            cursor: pointer;
            transition: box-shadow 0.3s ease, transform 0.3s ease;
        }
        .tilt-card:hover {
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        }

        /* Dark Mode Theme Styles */
        body.dark-mode {
            background-color: #121212 !important;
            color: #e0e0e0 !important;
        }
        body.dark-mode .card {
            background-color: #1e1e1e !important;
            color: #e0e0e0 !important;
            border-color: #333 !important;
        }
        body.dark-mode .dropdown-menu {
            background-color: #242424 !important;
        }
        body.dark-mode .dropdown-item {
            color: #e0e0e0 !important;
        }
        body.dark-mode .dropdown-item:hover {
            background-color: #333 !important;
            color: #ffffff !important;
        }
        body.dark-mode footer {
            color: #adb5bd !important;
        }

        /* Print Stylesheet */
        @media print {
            #loader-wrapper, .navbar, #guestNoticeCard, #backToTopBtn, #cookieBanner, footer, #scroll-progress, #floatingContactBtn {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
            .container {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
        }

       /* Compact Hover Dropdown - Deep Forest Green Theme */
    .navbar .dropdown:hover > .dropdown-menu {
        display: block !important;
        margin-top: 0px !important;
        border-radius: 6px;
        border-top: 3px solid #52b788;
        min-width: 200px;
    }
    .dropdown-menu {
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        background-color: #1b4332 !important;
        border: 1px solid #2d6a4f !important;
    }
    .dropdown-item {
        padding: 8px 16px;
        transition: background-color 0.15s ease-in-out;
        color: #e9ecef !important;
    }
    .dropdown-item:hover {
        background-color: #2d6a4f !important;
        color: #ffffff !important;
    }
    .dropdown-header {
        color: #95d5b2 !important;
    }
    .dropdown-divider {
        border-top-color: #2d6a4f !important;
    }

    /* Mobile Navigation Bar Polish */
@media (max-width: 768px) {
    /* Style the dropdown expansion box on mobile */
    .navbar-collapse {
        background-color: #ffffff;
        padding: 1.25rem;
        border-radius: 0.75rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        margin-top: 0.75rem;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }
    
    /* Give each nav link a subtle touch target and padding */
    .navbar-nav .nav-link {
        padding: 0.65rem 1rem;
        border-radius: 0.5rem;
        transition: background-color 0.2s ease;
    }
    
    /* Clean hover/active state for mobile taps */
    .navbar-nav .nav-link:hover, 
    .navbar-nav .nav-link:active {
        background-color: #f8f9fa;
        color: #2e7d32 !important;
    }
}
    </style>
    <!-- Bootstrap Icons CSS CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <!-- Skip to Content Link (Accessibility) -->
