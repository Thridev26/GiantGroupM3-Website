<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="GiantGroupM3.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - The Giant Group</title>

    <meta name="description" content="The Giant Group enterprise management platform. Powering professional tree-felling operations with seamless client quoting, real-time machine allocation and smart staff scheduling. Built by Code Crusaders." />
    <meta name="keywords" content="tree felling, vegetation management, enterprise portal, quoting system, operations management, Code Crusaders" />
    <meta name="author" content="Code Crusaders" />

    <meta property="og:title" content="The Giant Group | Enterprise Tree-Felling & Vegetation Management" />
    <meta property="og:description" content="Official enterprise portal developed by Code Crusaders." />
    <meta property="og:image" content="https://ist-wst-group-1.azurewebsites.net/images/The%20Giant%20Group%20Logo%20.png" />
    <meta property="og:url" content="https://ist-wst-group-1.azurewebsites.net/" />
    <meta property="og:type" content="website" />

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link rel="shortcut icon" href="~/Content/New Giant Tree Icon (1).ico" type="image/x-icon" />

    <!-- Fonts: Fraunces (display) + Inter (interface). Both have safe fallbacks. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- AOS Animation CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <!-- Bootstrap Icons CSS CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- =====================================================================
         GIANT GROUP DESIGN SYSTEM
         Tokens, shared components, navigation, footer, chat, loader
         ===================================================================== -->
    <style>
        :root {
            /* Brand greens (unchanged palette) */
            --gg-900: #0f2d1e;
            --gg-800: #1b4332;
            --gg-700: #2d6a4f;
            --gg-600: #40916c;
            --gg-500: #52b788;
            --gg-300: #95d5b2;
            --gg-100: #d8f3dc;

            /* Light theme surfaces */
            --gg-bg: #f3f6f4;
            --gg-surface: #ffffff;
            --gg-surface-2: #eaf1ed;
            --gg-border: #dce6e0;
            --gg-text: #13251c;
            --gg-muted: #5b6f64;
            --gg-accent: #2d6a4f;
            --gg-accent-soft: #e2f0e8;

            /* Status colours */
            --gg-amber: #a8650f;
            --gg-amber-soft: #fbf0dc;
            --gg-blue: #2b6cb0;
            --gg-blue-soft: #e4eef9;

            --gg-shadow-sm: 0 1px 2px rgba(15, 45, 30, .06);
            --gg-shadow-md: 0 14px 34px -14px rgba(15, 45, 30, .28);

            --gg-display: 'Fraunces', Georgia, 'Times New Roman', serif;
            --gg-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }

        body.dark-mode {
            --gg-bg: #0b1410;
            --gg-surface: #12201a;
            --gg-surface-2: #182a22;
            --gg-border: #233a2f;
            --gg-text: #e5eee9;
            --gg-muted: #9bb2a6;
            --gg-accent: #52b788;
            --gg-accent-soft: #173427;
            --gg-amber: #e0a84a;
            --gg-amber-soft: #3a2d12;
            --gg-blue: #7fb2e8;
            --gg-blue-soft: #15283d;
            --gg-shadow-sm: 0 1px 2px rgba(0, 0, 0, .4);
            --gg-shadow-md: 0 14px 34px -14px rgba(0, 0, 0, .7);
        }

        /* ---------- Base ---------- */
        html, body { height: 100%; margin: 0; }
        body {
            display: flex; flex-direction: column; min-height: 100vh;
            font-family: var(--gg-sans);
            background: var(--gg-bg);
            color: var(--gg-text);
            -webkit-font-smoothing: antialiased;
        }
        form { display: flex; flex-direction: column; flex: 1 0 auto; margin: 0; }
        .body-content { flex: 1 0 auto; }
        footer { flex-shrink: 0; }
        .py-2-5 { padding-top: .75rem !important; padding-bottom: .75rem !important; }

        :focus-visible { outline: 3px solid var(--gg-500); outline-offset: 2px; }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
        }

        /* ---------- Loader (kept) ---------- */
        #loader-wrapper {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #40916c;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            z-index: 9999; transition: opacity .5s ease;
        }
        #loader-wrapper p {
            color: #fff; font-family: var(--gg-sans); margin-top: 0;
            letter-spacing: .04em; font-weight: 500;
        }
        #tree-canvas-container {
            width: 300px; height: 300px; max-width: 70vw; max-height: 70vw;
            display: flex; justify-content: center; align-items: center;
        }
        #tree-canvas-container canvas { width: 100% !important; height: 100% !important; outline: none; }

        /* ---------- Legacy helpers (other pages still use these) ---------- */
        .tilt-card { transform-style: preserve-3d; transform: perspective(1000px); cursor: pointer; transition: box-shadow .3s ease, transform .3s ease; }
        .tilt-card:hover { box-shadow: 0 10px 20px rgba(0,0,0,.15); }

        .btn-success { background-color: #2d6a4f !important; border-color: #2d6a4f !important; }
        .btn-success:hover { background-color: #1b4332 !important; border-color: #1b4332 !important; }
        .btn-outline-success { color: #2d6a4f !important; border-color: #2d6a4f !important; }
        .btn-outline-success:hover { background-color: #2d6a4f !important; color: #fff !important; }
        .text-success { color: #2d6a4f !important; }
        .border-success { border-color: #2d6a4f !important; }
        body.dark-mode .text-success { color: #52b788 !important; }

        body.dark-mode .card { background-color: #12201a !important; color: #e5eee9 !important; border-color: #233a2f !important; }
        body.dark-mode .text-dark { color: #52b788 !important; }
        body.dark-mode .text-muted { color: #95d5b2 !important; }
        body.dark-mode .bg-white .text-dark, body.dark-mode .bg-light .text-dark, body.dark-mode .modal-content .text-dark { color: #212529 !important; }
        body.dark-mode .bg-white .text-muted, body.dark-mode .bg-light .text-muted, body.dark-mode .modal-content .text-muted { color: #6c757d !important; }

        /* =====================================================================
           SHARED COMPONENTS (used by Default, Client Portal, Management Portal)
           ===================================================================== */
        .gg-display { font-family: var(--gg-display); font-weight: 600; letter-spacing: -.015em; }

        .gg-label {
            display: inline-flex; align-items: center; gap: .5rem;
            font-size: .85rem; font-weight: 600; color: var(--gg-accent);
        }
        .gg-label i { font-size: 1rem; }

        .gg-surface {
            background: var(--gg-surface);
            border: 1px solid var(--gg-border);
            border-radius: 14px;
            box-shadow: var(--gg-shadow-sm);
        }

        .gg-muted { color: var(--gg-muted) !important; }

        /* Buttons */
        .gg-btn {
            display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
            font-family: var(--gg-sans); font-weight: 600; font-size: .92rem; line-height: 1.2;
            padding: .7rem 1.2rem; border-radius: 10px; border: 1px solid transparent;
            text-decoration: none !important; cursor: pointer;
            transition: background-color .15s ease, color .15s ease, border-color .15s ease, box-shadow .15s ease;
        }
        .gg-btn-primary { background: var(--gg-700); color: #fff !important; }
        .gg-btn-primary:hover { background: var(--gg-800); box-shadow: 0 6px 16px -6px rgba(27,67,50,.6); }
        .gg-btn-outline { background: transparent; color: var(--gg-text) !important; border-color: var(--gg-border); }
        .gg-btn-outline:hover { border-color: var(--gg-accent); color: var(--gg-accent) !important; }
        .gg-btn-light { background: #fff; color: var(--gg-800) !important; }
        .gg-btn-light:hover { background: var(--gg-100); }
        .gg-btn-ghost-light { background: transparent; color: #fff !important; border-color: rgba(255,255,255,.4); }
        .gg-btn-ghost-light:hover { background: rgba(255,255,255,.12); border-color: #fff; }
        .gg-btn-arrow::after { content: "\f138"; font-family: "bootstrap-icons"; font-size: .95rem; transition: transform .15s ease; }
        .gg-btn-arrow:hover::after { transform: translateX(3px); }

        /* Icon tile */
        .gg-tile {
            width: 42px; height: 42px; flex-shrink: 0; border-radius: 10px;
            display: inline-flex; align-items: center; justify-content: center;
            background: var(--gg-accent-soft); color: var(--gg-accent); font-size: 1.2rem;
        }
        .gg-tile.is-amber { background: var(--gg-amber-soft); color: var(--gg-amber); }
        .gg-tile.is-blue  { background: var(--gg-blue-soft);  color: var(--gg-blue); }
        .gg-tile.is-lg { width: 52px; height: 52px; border-radius: 12px; font-size: 1.5rem; }

        /* Status chips */
        .gg-chip {
            display: inline-flex; align-items: center; gap: .4rem;
            font-size: .78rem; font-weight: 600; padding: .25rem .7rem; border-radius: 999px;
            background: var(--gg-surface-2); color: var(--gg-muted); white-space: nowrap;
        }
        .gg-chip::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
        .gg-chip.is-pending { background: var(--gg-amber-soft); color: var(--gg-amber); }
        .gg-chip.is-active  { background: var(--gg-blue-soft);  color: var(--gg-blue); }
        .gg-chip.is-done    { background: var(--gg-accent-soft); color: var(--gg-accent); }

        /* Portal banner (tree-ring motif) */
        .gg-banner {
            position: relative; overflow: hidden; color: #fff;
            border-radius: 22px; padding: 2.5rem 2.5rem;
            background: linear-gradient(135deg, var(--gg-800) 0%, var(--gg-900) 100%);
            box-shadow: var(--gg-shadow-md);
        }
        .gg-banner::before {
            content: ""; position: absolute; inset: 0; pointer-events: none;
            background: repeating-radial-gradient(circle at 92% 50%, rgba(149,213,178,.13) 0 1.5px, transparent 1.5px 24px);
            -webkit-mask-image: radial-gradient(circle at 92% 50%, #000 0, transparent 60%);
                    mask-image: radial-gradient(circle at 92% 50%, #000 0, transparent 60%);
        }
        .gg-banner > * { position: relative; }
        .gg-banner h1 { font-family: var(--gg-display); font-weight: 600; letter-spacing: -.02em; color: #fff; }
        .gg-banner p { color: #cfe5d9; }
        @media (max-width: 576px) { .gg-banner { padding: 1.75rem 1.5rem; border-radius: 18px; } }

        /* KPI cards */
        .gg-kpi { position: relative; padding: 1.25rem 1.4rem 1.25rem 1.6rem; height: 100%; overflow: hidden; }
        .gg-kpi::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--gg-500); }
        .gg-kpi.is-amber::before { background: var(--gg-amber); }
        .gg-kpi.is-blue::before  { background: var(--gg-blue); }
        .gg-kpi-label { font-size: .88rem; font-weight: 600; color: var(--gg-muted); line-height: 1.3; min-width: 0; padding-right: .5rem; }
        .gg-kpi .d-flex { gap: .75rem; }
        .gg-kpi-value { font-family: var(--gg-display); font-size: 2.6rem; font-weight: 600; line-height: 1; margin: .7rem 0 .4rem; color: var(--gg-text); }
        .gg-kpi-note { font-size: .82rem; color: var(--gg-muted); }

        /* List rows */
        .gg-row {
            display: flex; align-items: center; justify-content: space-between; gap: 1rem;
            padding: .85rem 1.1rem; text-decoration: none !important; color: var(--gg-text) !important;
            border-bottom: 1px solid var(--gg-border); transition: background-color .15s ease;
        }
        .gg-row:last-child { border-bottom: 0; }
        .gg-row:hover { background: var(--gg-surface-2); }
        .gg-row-title { font-weight: 600; font-size: .95rem; }
        .gg-row-sub { font-size: .8rem; color: var(--gg-muted); }

        .gg-section-title { font-family: var(--gg-display); font-weight: 600; font-size: 1.4rem; letter-spacing: -.01em; margin: 0; color: var(--gg-text); }
        body.dark-mode .gg-section-title { color: var(--gg-text) !important; }

        .gg-alert {
            display: flex; gap: .75rem; align-items: flex-start; padding: .9rem 1.1rem; border-radius: 12px;
            background: var(--gg-amber-soft); color: var(--gg-amber); font-size: .9rem; font-weight: 500;
        }

        /* =====================================================================
           NAVIGATION
           ===================================================================== */
        .gg-nav {
            background: rgba(20, 52, 38, .94) !important;
            -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(255,255,255,.08);
            padding-top: .5rem; padding-bottom: .5rem;
        }
        .gg-nav .nav-link {
            font-size: .9rem; font-weight: 500; color: rgba(255,255,255,.8);
            border-radius: 8px; padding: .5rem .8rem !important;
            transition: background-color .15s ease, color .15s ease;
        }
        .gg-nav .nav-link:hover, .gg-nav .nav-link:focus, .gg-nav .show > .nav-link { background: rgba(255,255,255,.1); color: #fff; }
        .gg-nav .navbar-toggler { border-color: rgba(255,255,255,.3); }

        .dropdown-menu {
            background-color: #12301f !important;
            border: 1px solid rgba(255,255,255,.1) !important;
            border-radius: 14px; padding: .5rem !important; min-width: 220px;
            box-shadow: 0 18px 40px -10px rgba(0,0,0,.45);
        }
        .dropdown-item {
            padding: .5rem .8rem; border-radius: 8px; font-size: .9rem;
            color: #e3efe8 !important; transition: background-color .15s ease;
        }
        .dropdown-item:hover { background-color: #2d6a4f !important; color: #fff !important; }
        .dropdown-header { color: var(--gg-300) !important; font-size: .78rem; font-weight: 600; letter-spacing: .02em; padding: .4rem .8rem; }
        .gg-nav .dropdown-header { color: var(--gg-300) !important; }
        .dropdown-divider { border-top-color: rgba(255,255,255,.1) !important; }

        @media (min-width: 992px) {
            .navbar .dropdown:hover > .dropdown-menu { display: block !important; margin-top: 0 !important; animation: ggDrop .16s ease; }
        }
        @keyframes ggDrop { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

        @media (max-width: 991.98px) {
            .gg-nav .navbar-collapse {
                background: rgba(15, 45, 30, .98); padding: 1rem; border-radius: 14px; margin-top: .75rem;
                border: 1px solid rgba(255,255,255,.08); box-shadow: 0 18px 40px -10px rgba(0,0,0,.4);
            }
            .gg-nav .dropdown-menu { box-shadow: none; background-color: rgba(255,255,255,.04) !important; }
            .gg-search { width: 100% !important; }
        }

        /* =====================================================================
           FLOATING UI
           ===================================================================== */
        #scroll-progress { position: fixed; top: 0; left: 0; height: 3px; background: linear-gradient(90deg, #52b788, #95d5b2); width: 0; z-index: 1095; transition: width .1s ease; }

        .gg-fab-wrap {  position: fixed; right: 1.25rem;bottom: 5rem; z-index: 1060;display: flex;flex-direction: column-reverse;             
           align-items: center;gap: .6rem;}
                       
                      
                      
                         
          
                  
                      
                  
      .gg-fab {
            height: 52px; border: 0; border-radius: 999px; color: #fff !important; text-decoration: none !important;
            background: var(--gg-700) !important; box-shadow: 0 10px 24px -8px rgba(15,45,30,.6);
            display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
            transition: background-color .15s ease, transform .15s ease;
        }
        .contact-tooltip {position: absolute;right: 60px;bottom:56px;background: var(--gg-surface);color: var(--gg-text); padding: 12px 16px;
                     border-radius: 12px;box-shadow: var(--gg-shadow-md);border: 1px solid var(--gg-border);
                      width: 220px; font-size: 13px;z-index: 1080; opacity: 0; visibility: hidden;transition: opacity .3s ease;
                      }
          .contact-tooltip.show {
         opacity: 1;
           visibility: visible;
          }         
   
    
   
   
    



        .gg-fab:hover { background: var(--gg-800) !important; transform: translateY(-2px); }
        .gg-fab.is-round { width: 48px; height: 48px;border-radius: 50%; padding: 0; display: flex;align-items: center; justify-content: center; }
        .gg-fab.is-pill { padding: 0 1.2rem; font-weight: 600; font-size: .92rem; }
        .gg-fab img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }

        #backToTopBtn {
            position: fixed; left: 1.25rem; bottom: 1.25rem; z-index: 1060; display: none;
            width: 44px; height: 44px; border-radius: 50%; padding: 0;
            align-items: center; justify-content: center;
            background: var(--gg-700) !important; color: #fff; border: 0; box-shadow: 0 10px 24px -8px rgba(15,45,30,.6);
        }
        body.has-cookie .gg-fab-wrap, body.has-cookie #backToTopBtn { bottom: 9.5rem; }
        @media (max-width: 767.98px) { body.has-cookie .gg-fab-wrap, body.has-cookie #backToTopBtn { bottom: 13.5rem; } }

        /* Cookie banner */
        .gg-cookie {
            position: fixed; z-index: 1040; bottom: 1rem; left: 50%; transform: translateX(-50%);
            width: min(960px, calc(100% - 2rem));
            background: rgba(15,45,30,.97); color: #e3efe8; border: 1px solid rgba(255,255,255,.1);
            border-radius: 16px; padding: 1rem 1.25rem; box-shadow: 0 24px 50px -12px rgba(0,0,0,.5);
        }
        .gg-cookie-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
        .gg-cookie-text { display: flex; gap: .75rem; align-items: flex-start; font-size: .88rem; flex: 1 1 380px; }
        .gg-cookie-text > i { font-size: 1.3rem; color: var(--gg-500); }
        .gg-cookie a { color: var(--gg-300); }
        .gg-cookie-actions { display: flex; gap: .5rem; flex-shrink: 0; }

        /* Guest notice */
        .gg-notice {
            z-index: 1050; bottom: 190px; max-width: 400px; display: none;
            background: var(--gg-surface); color: var(--gg-text);
            border: 1px solid var(--gg-border) !important; border-left: 5px solid var(--gg-600) !important;
            border-radius: 14px; box-shadow: var(--gg-shadow-md);
        }
        .gg-notice h5 { font-family: var(--gg-display); font-weight: 600; }
        .gg-notice-close { background: none; border: 0; color: var(--gg-muted); font-size: 1.4rem; line-height: 1; padding: 0; }

        /* =====================================================================
           OAK CHAT
           ===================================================================== */
      

#chatbotPopup {
    position: fixed;
    right: 1.25rem;
    bottom: 30px;
    z-index: 1070;
    width: 370px;
    max-width: calc(100vw - 2rem);
    height: 540px;
    max-height: calc(100vh - 8rem);
    display: none;
    border-radius: 22px;
    overflow: hidden;
    background: var(--gg-surface);
    border: 1px solid var(--gg-border);
    box-shadow: 0 24px 60px -14px rgba(0,0,0,.45);
}

#chatbotPopup .oak-chat {
    display: flex;
    flex-direction: column;
    height: 100%;
}

#chatbotPopup .oak-chat-head {
    position: relative;
    flex-shrink: 0;
    color: #fff;
    text-align: center;
    padding: 1.25rem 1rem .9rem;
    background: linear-gradient(135deg, #2d6a4f, #1b4332);
    overflow: visible;
}

#chatbotPopup .oak-chat-icon {
    display: block;
    margin: 0 auto .5rem;
    width: 84px;
    height: 84px;
    object-fit: contain;
    background: transparent;
}

#chatbotPopup .oak-chat-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    padding: 0;
    margin: 0;
    border-radius: 50%;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.3);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    box-sizing: border-box;
}

#chatbotPopup .oak-chat-close:hover {
    background: rgba(255,255,255,.25);
}

#chatbotPopup .oak-chat-body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 1rem;
    background: var(--gg-bg);
}

#chatbotPopup .oak-chat-foot {
    flex-shrink: 0;
    padding: .75rem;
    background: var(--gg-surface);
    border-top: 1px solid var(--gg-border);
}

#chatbotPopup .gg-bubble {
    border-radius: 14px !important;
    line-height: 1.5;
}

#chatbotPopup .bg-success {
    background-color: var(--gg-700) !important;
}

#chatbotPopup .form-control {
    background: var(--gg-surface-2) !important;
    color: var(--gg-text);
    border-radius: 10px 0 0 10px;
}

#chatbotPopup .form-control::placeholder {
    color: var(--gg-muted);
}

#chatbotPopup .btn-success {
    border-radius: 0 10px 10px 0;
}

.oak-dots span {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 0 2px;
    border-radius: 50%;
    background: #2d6a4f;
    animation: oakBounce 1.2s infinite ease-in-out;
}

.oak-dots span:nth-child(2) {
    animation-delay: .2s;
}

.oak-dots span:nth-child(3) {
    animation-delay: .4s;
}

@keyframes oakBounce {
    0%, 80%, 100% {
        opacity: .25;
        transform: translateY(0);
    }
    40% {
        opacity: 1;
        transform: translateY(-4px);
    }
}

body.dark-mode #chatbotPopup .oak-chat-head {
    background: linear-gradient(135deg, #1b4332, #0f2d1e);
}

body.dark-mode #chatbotPopup .bg-white {
    background-color: #1d2f27 !important;
    color: #e5eee9 !important;
}

body.dark-mode #chatbotPopup .text-dark {
    color: #e5eee9 !important;
}

body.dark-mode #chatbotPopup .text-success,
body.dark-mode #chatbotPopup a.text-success {
    color: #52b788 !important;
}

body.dark-mode #chatbotPopup .btn-outline-success {
    color: #52b788 !important;
    border-color: #52b788 !important;
}

body.dark-mode #chatbotPopup .btn-outline-success:hover {
    background-color: #2d6a4f !important;
    color: #fff !important;
}

body.dark-mode #chatbotPopup .oak-dots span {
    background: #52b788;
}

@keyframes oakBob {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-5px);
    }
}

#chatbotPopup .oak-chat-icon.is-thinking {
    animation: oakBob 1s ease-in-out infinite;
}


        /* =====================================================================
           FOOTER
           ===================================================================== */
        .gg-footer { background: var(--gg-900); color: #a9c1b3; border-top: 1px solid rgba(255,255,255,.06); padding: 2rem 0; margin-top: 2rem; }
        .gg-footer strong, .gg-footer .gg-footer-brand { color: #fff; }
        .gg-footer a { color: #a9c1b3; text-decoration: none; transition: color .15s ease; }
        .gg-footer a:hover { color: #fff; }
        .gg-footer .gg-footer-accent { color: var(--gg-500) !important; font-weight: 600; }
        .gg-footer .gg-footer-sep { opacity: .35; }
        .gg-footer .gg-social { width: 34px; height: 34px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,.07); font-size: 1rem; }
        .gg-footer .gg-social:hover { background: var(--gg-700); }

        /* =====================================================================
           PRINT
           ===================================================================== */
        @media print {
            #loader-wrapper, .navbar, #guestNoticeCard, #backToTopBtn, #cookieBanner, #cookieConsentBanner, footer, #scroll-progress, #floatingContactBtn, .gg-fab-wrap, #chatbotPopup { display: none !important; }
            body { background: #fff !important; color: #000 !important; }
            .container { width: 100% !important; max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
        }
        /* =========================================================
   giant-ui.css  -  shared styles for Giant Group inner pages
   Uses the colour tokens defined in Site.Master (--gg-*),
   so light and dark mode both work automatically.
   ========================================================= */

.gg-page { max-width: 1140px; margin: 0 auto; padding: .5rem 0 1.5rem; }
.gg-page-head { margin-bottom: 1.5rem; }
.gg-page-head h1 { font-family: var(--gg-display, Georgia, serif); font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem); letter-spacing: -.02em; margin: .3rem 0 .4rem; color: var(--gg-text); }
.gg-page-head p { color: var(--gg-muted); margin: 0; max-width: 640px; line-height: 1.6; }

/* Panels */
.gg-panel { background: var(--gg-surface); border: 1px solid var(--gg-border); border-radius: 16px; box-shadow: var(--gg-shadow-sm); }
.gg-panel-body { padding: 1.5rem; }
.gg-panel-head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
.gg-step-title { display: flex; align-items: center; gap: .75rem; font-weight: 700; font-size: 1.05rem; margin: 0; color: var(--gg-text); }
.gg-step-n { width: 28px; height: 28px; border-radius: 50%; background: var(--gg-700); color: #fff; font-size: .82rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
.gg-step-n.is-idle { background: var(--gg-surface-2); color: var(--gg-muted); }

/* Inputs */
.gg-input, .gg-select { display: block; width: 100%; background: var(--gg-surface); color: var(--gg-text); border: 1px solid var(--gg-border); border-radius: 10px; padding: .65rem .85rem; font-size: .95rem; transition: border-color .15s ease, box-shadow .15s ease; }
.gg-input::placeholder { color: var(--gg-muted); opacity: .8; }
.gg-input:focus, .gg-select:focus { outline: none; background: var(--gg-surface); color: var(--gg-text); border-color: var(--gg-600); box-shadow: 0 0 0 4px rgba(64, 145, 108, .18); }
.gg-field-label { display: block; font-size: .85rem; font-weight: 600; color: var(--gg-muted); margin-bottom: .35rem; }
.gg-field-error { display: block; color: #c0392b; font-size: .82rem; margin-top: .3rem; }
body.dark-mode .gg-field-error { color: #f1948a; }
.gg-search-box { position: relative; width: 100%; max-width: 340px; }
.gg-search-box > i { position: absolute; left: .9rem; top: 50%; transform: translateY(-50%); color: var(--gg-accent); pointer-events: none; }
.gg-search-box .gg-input { padding-left: 2.5rem; }
.gg-search-wrap { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }

/* Small button size (base .gg-btn lives in Site.Master) */
.gg-btn-sm { padding: .42rem .8rem; font-size: .82rem; border-radius: 8px; }
.gg-btn-danger-outline { background: transparent; color: #c0392b !important; border-color: #e5b4ae; }
.gg-btn-danger-outline:hover { background: #fdecea; border-color: #c0392b; }
body.dark-mode .gg-btn-danger-outline { color: #f1948a !important; border-color: #6b3b36; }
body.dark-mode .gg-btn-danger-outline:hover { background: #3a1f1c; }
.gg-btn.aspNetDisabled, .gg-btn[disabled], .gg-btn:disabled { opacity: .45; pointer-events: none; cursor: not-allowed; }

/* Tables (use CssClass="table gg-table" on GridView) */
.gg-table { --bs-table-bg: transparent; --bs-table-color: var(--gg-text); --bs-table-hover-bg: var(--gg-surface-2); --bs-table-hover-color: var(--gg-text); --bs-table-striped-bg: transparent; --bs-table-border-color: var(--gg-border); margin: 0; color: var(--gg-text); }
.gg-table th { background: var(--gg-surface-2) !important; color: var(--gg-muted) !important; font-size: .78rem; font-weight: 600; letter-spacing: .02em; padding: .85rem 1rem; border-bottom: 1px solid var(--gg-border) !important; white-space: nowrap; }
.gg-table td { padding: .85rem 1rem; vertical-align: middle; border-color: var(--gg-border); font-size: .92rem; background: transparent; color: var(--gg-text); }
.gg-table .gg-sub { font-size: .8rem; color: var(--gg-muted); }
.gg-table-wrap { overflow-x: auto; border-radius: 16px; }
.gg-table-wrap > table { min-width: 640px; }

/* Pager */
.gg-pager { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; padding: .85rem 1.1rem; background: var(--gg-surface); border-top: 1px solid var(--gg-border); }
.gg-pager-info { color: var(--gg-muted); font-size: .88rem; }
.gg-pager-btn { display: inline-block; background: transparent; color: var(--gg-text) !important; border: 1px solid var(--gg-border); padding: .4rem .9rem; border-radius: 8px; font-size: .84rem; font-weight: 600; text-decoration: none !important; transition: border-color .15s ease, color .15s ease; cursor: pointer; }
.gg-pager-btn:hover:not(.disabled) { border-color: var(--gg-accent); color: var(--gg-accent) !important; }
.gg-pager-btn.disabled, .gg-pager-btn:disabled { opacity: .4; pointer-events: none; cursor: not-allowed; }

/* Messages */
.gg-msg { display: block; padding: .85rem 1.1rem; border-radius: 12px; font-size: .92rem; font-weight: 500; margin-bottom: 1.25rem; border: 1px solid transparent; }
.gg-msg.is-success { background: var(--gg-accent-soft); color: var(--gg-accent); border-color: rgba(64, 145, 108, .25); }
.gg-msg.is-info { background: var(--gg-blue-soft); color: var(--gg-blue); }
.gg-msg.is-warning { background: var(--gg-amber-soft); color: var(--gg-amber); }
.gg-msg.is-error { background: #fdecea; color: #b03a2e; }
body.dark-mode .gg-msg.is-error { background: #3a1f1c; color: #f1948a; }

/* Selected-job banner */
.gg-selected { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; background: var(--gg-accent-soft); border: 1px solid rgba(64, 145, 108, .3); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
.gg-selected small { color: var(--gg-accent); font-weight: 600; }
.gg-selected strong { color: var(--gg-text); }

/* Empty state */
.gg-empty { text-align: center; padding: 2.75rem 1.5rem; color: var(--gg-muted); }
.gg-empty h3 { font-family: var(--gg-display, Georgia, serif); color: var(--gg-text); font-size: 1.25rem; margin: 1rem 0 .4rem; }
.gg-empty p { max-width: 460px; margin: 0 auto; line-height: 1.6; }

/* Auth pages (login / register) */
.gg-auth-wrap { min-height: 72vh; display: flex; align-items: center; justify-content: center; padding: 1.5rem 0; }
.gg-auth-card { width: 100%; max-width: 480px; background: var(--gg-surface); border: 1px solid var(--gg-border); border-radius: 22px; box-shadow: var(--gg-shadow-md); overflow: hidden; }
.gg-auth-card.is-wide { max-width: 560px; }
.gg-auth-top { position: relative; padding: 2rem 2rem 1.6rem; color: #fff; text-align: center; background: linear-gradient(135deg, var(--gg-800), var(--gg-900)); overflow: hidden; }
.gg-auth-top::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: repeating-radial-gradient(circle at 100% 0%, rgba(149, 213, 178, .16) 0 1.5px, transparent 1.5px 22px); -webkit-mask-image: radial-gradient(circle at 100% 0%, #000, transparent 65%); mask-image: radial-gradient(circle at 100% 0%, #000, transparent 65%); }
.gg-auth-top > * { position: relative; }
.gg-auth-top h1 { font-family: var(--gg-display, Georgia, serif); font-weight: 600; font-size: 1.7rem; letter-spacing: -.02em; margin: .75rem 0 .3rem; color: #fff; }
.gg-auth-top p { margin: 0; color: #cfe5d9; font-size: .92rem; }
.gg-auth-icon { width: 54px; height: 54px; border-radius: 14px; background: rgba(255, 255, 255, .14); display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; }
.gg-auth-body { padding: 1.75rem 2rem 2rem; }
.gg-auth-body .gg-field { margin-bottom: 1.1rem; }
.gg-auth-foot { text-align: center; font-size: .9rem; color: var(--gg-muted); margin-top: 1.5rem; }
.gg-auth-foot a, .gg-link { color: var(--gg-accent) !important; font-weight: 600; text-decoration: none; }
.gg-auth-foot a:hover, .gg-link:hover { text-decoration: underline; }
.gg-iconfield { display: flex; align-items: stretch; background: var(--gg-surface); border: 1px solid var(--gg-border); border-radius: 10px; overflow: hidden; transition: border-color .15s ease, box-shadow .15s ease; }
.gg-iconfield:focus-within { border-color: var(--gg-600); box-shadow: 0 0 0 4px rgba(64, 145, 108, .18); }
.gg-iconfield > i.lead-i { display: flex; align-items: center; padding: 0 .85rem; color: var(--gg-muted); }
.gg-iconfield .gg-input { border: 0; border-radius: 0; box-shadow: none !important; flex: 1; min-width: 0; }
.gg-iconfield { position: relative !important; display: flex; align-items: stretch; background: var(--gg-surface); border: 1px solid var(--gg-border); border-radius: 10px; overflow: hidden; }

/* Password eye toggle: one style for every password field (the icon is added by section 7 of the script) */
.gg-pw { position: relative; }
.gg-iconfield input[type="password"], .gg-pw > input[type="password"] { padding-right: 2.75rem !important; }
.gg-eye { position: absolute; right: .4rem; top: 50%; transform: translateY(-50%); z-index: 2; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; border-radius: 8px; background: transparent; color: var(--gg-muted); box-shadow: none; line-height: 1; cursor: pointer; }
.gg-eye:hover { background: var(--gg-surface-2); color: var(--gg-accent); }
.gg-eye:focus-visible { outline: 2px solid var(--gg-500); outline-offset: 1px; }

/* Return to Portal (bottom of every logged-in page) */
.gg-return { display: flex; justify-content: center; padding: 1.5rem 0 .5rem; }
.gg-return-btn { min-width: 220px; }
@media print { .gg-return { display: none !important; } }
.gg-divider { display: flex; align-items: center; gap: .75rem; color: var(--gg-muted); font-size: .8rem; margin: 1.25rem 0; }
.gg-divider::before, .gg-divider::after { content: ""; flex: 1; height: 1px; background: var(--gg-border); }
.gg-google { background: #fff !important; color: #3c4043 !important; border: 1px solid #dadce0 !important; width: 100%; }
.gg-google:hover { background: #f8f9fa !important; box-shadow: 0 1px 3px rgba(60, 64, 67, .3); }
.gg-otp { text-align: center; font-size: 1.9rem; font-weight: 700; letter-spacing: .5em; padding-left: .5em; max-width: 280px; margin: 0 auto; }
.gg-check { display: flex; align-items: center; gap: .55rem; font-size: .88rem; color: var(--gg-muted); cursor: pointer; user-select: none; }
.gg-check input { width: 1.05rem; height: 1.05rem; accent-color: var(--gg-700); }

/* Password rules checklist */
.gg-rules { list-style: none; padding: 0; margin: .6rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: .2rem .75rem; font-size: .78rem; color: var(--gg-muted); }
.gg-rules li::before { content: "\f287"; font-family: "bootstrap-icons"; margin-right: .35rem; }
.gg-rules li.ok { color: var(--gg-accent); }
.gg-rules li.ok::before { content: "\f26a"; }
.gg-meter { height: 5px; border-radius: 99px; background: var(--gg-surface-2); overflow: hidden; margin-top: .6rem; }
.gg-meter > div { height: 100%; width: 0; transition: width .3s ease, background-color .3s ease; }

@media (max-width: 575.98px) {
    .gg-auth-top, .gg-auth-body { padding-left: 1.4rem; padding-right: 1.4rem; }
    .gg-rules { grid-template-columns: 1fr; }
    .gg-panel-body { padding: 1.1rem; }
}
    </style>
</head>
<body>
    <script>
        // Apply saved theme before first paint to prevent a light-mode flash
        try { if (localStorage.getItem('theme') === 'dark') document.body.classList.add('dark-mode'); } catch (e) { }
    </script>

    <!-- Skip to Content Link (Accessibility) -->
    <a class="visually-hidden-focusable btn btn-light position-absolute top-0 start-0 m-2 shadow" href="#main-content" style="z-index: 1100;">Skip to content</a>

    <!-- Scroll Progress Bar -->
    <div id="scroll-progress"></div>

    <!-- 3D Loader Overlay -->
    <div id="loader-wrapper">
        <div id="tree-canvas-container"></div>
        <p>Loading The Giant Group...</p>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        (function () {
            var loader = document.getElementById('loader-wrapper');
            var container = document.getElementById('tree-canvas-container');
            if (!loader || !container || typeof THREE === 'undefined') return;

            // If the browser can't do WebGL, just show the text
            var renderer;
            try {
                renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            } catch (e) {
                container.style.display = 'none';
                return;
            }
            renderer.setSize(300, 300);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(renderer.domElement);

            var scene = new THREE.Scene();
            var camera = new THREE.PerspectiveCamera(45, 1, 0.1, 1000);
            camera.position.set(0, 3.5, 8);
            camera.lookAt(0, 2, 0);

            var treeGroup = new THREE.Group();
            scene.add(treeGroup);

            var wireframeMaterial = new THREE.MeshBasicMaterial({
                color: 0xffffff, wireframe: true, transparent: true, opacity: 0.9
            });
            var fillMaterial = new THREE.MeshBasicMaterial({
                color: 0xffffff, wireframe: false, transparent: true, opacity: 0.08
            });

            // Trunk
            var trunkGeo = new THREE.CylinderGeometry(0.12, 0.35, 2.5, 6);
            trunkGeo.translate(0, 1.25, 0);
            treeGroup.add(new THREE.Mesh(trunkGeo, wireframeMaterial));

            // Branches
            var branch1Geo = new THREE.CylinderGeometry(0.06, 0.12, 1.4, 5);
            branch1Geo.translate(0, 0.7, 0);
            var branch1 = new THREE.Mesh(branch1Geo, wireframeMaterial);
            branch1.position.set(0, 1.8, 0);
            branch1.rotation.z = Math.PI / 5;
            branch1.rotation.y = Math.PI / 4;
            treeGroup.add(branch1);

            var branch2Geo = new THREE.CylinderGeometry(0.06, 0.12, 1.3, 5);
            branch2Geo.translate(0, 0.65, 0);
            var branch2 = new THREE.Mesh(branch2Geo, wireframeMaterial);
            branch2.position.set(0, 1.7, 0);
            branch2.rotation.z = -Math.PI / 4;
            branch2.rotation.y = -Math.PI / 3;
            treeGroup.add(branch2);

            // Canopy
            var crown1Geo = new THREE.IcosahedronGeometry(1.6, 1);
            crown1Geo.translate(0, 3.3, 0);
            treeGroup.add(new THREE.Mesh(crown1Geo, wireframeMaterial));
            treeGroup.add(new THREE.Mesh(crown1Geo, fillMaterial));

            var crown2Geo = new THREE.IcosahedronGeometry(1.1, 1);
            crown2Geo.translate(-1.2, 2.7, 0.4);
            treeGroup.add(new THREE.Mesh(crown2Geo, wireframeMaterial));
            treeGroup.add(new THREE.Mesh(crown2Geo, fillMaterial));

            var crown3Geo = new THREE.IcosahedronGeometry(1.15, 1);
            crown3Geo.translate(1.2, 2.8, -0.3);
            treeGroup.add(new THREE.Mesh(crown3Geo, wireframeMaterial));
            treeGroup.add(new THREE.Mesh(crown3Geo, fillMaterial));

            // Growth + spin. The site's own code decides when the loader hides.
            var GROW_MS = 1200;
            var startTime = performance.now();
            var wasHidden = false;

            function animate() {
                requestAnimationFrame(animate);

                // Loader hidden: do nothing (saves battery/CPU)
                if (loader.style.display === 'none') { wasHidden = true; return; }

                // Loader shown again (e.g. clicking a link): regrow the tree
                if (wasHidden) { wasHidden = false; startTime = performance.now(); }

                var t = Math.min((performance.now() - startTime) / GROW_MS, 1);
                var s = Math.max(0.01, 1 - Math.pow(1 - t, 3));   // ease-out growth
                treeGroup.scale.set(s, s, s);
                treeGroup.rotation.y += 0.018;

                renderer.render(scene, camera);
            }
            animate();
        })();
    </script>

    <!-- Back to Top Button -->
    <button id="backToTopBtn" class="btn btn-success" type="button" title="Back to top" aria-label="Back to top"><i class="bi bi-arrow-up"></i></button>

    <!-- Bottom-right floating buttons -->
    <div class="gg-fab-wrap d-flex flex-column-reverse align-items-center gap-2">
        <!-- 1. Chatbot trigger -->
        <button type="button" class="gg-fab is-round" title="Open quick chat with Oak" aria-label="Open quick chat with Oak" onclick="toggleChatbot()">
            <img src="<%= ResolveUrl("~/Content/oak-icon.png") %>" alt="Oak" />
        </button>

        <!-- 2. Contact page link -->
        <div id="contactTooltip" class="contact-tooltip">
    Need assistance? Contact The Giant Group here.
</div>
        <a id="floatingContactBtn" runat="server"
   href="~/Contact.aspx"
   class="gg-fab is-round"
   title="Contact Us"
   aria-label="Contact us">

    <i class="bi bi-telephone-fill"></i>

</a>
    </div>

    <!-- Cookie Consent Banner -->
    <div id="cookieConsentBanner" class="gg-cookie" role="dialog" aria-label="Cookie notice" style="display: none;">
        <div class="gg-cookie-inner">
            <div class="gg-cookie-text">
                <i class="bi bi-shield-check"></i>
                <div>
                    <strong>Cookie notice.</strong> We use cookies to enhance your navigation experience, manage secure login sessions, and analyze site traffic. You can accept all cookies or reject non-essential ones.
                    <a href="~/Privacy.aspx" runat="server">Learn more</a>
                </div>
            </div>
            <div class="gg-cookie-actions">
                <button type="button" id="btnRejectCookies" class="btn btn-outline-light btn-sm px-3">Reject non-essential</button>
                <button type="button" id="btnAcceptCookies" class="btn btn-success btn-sm px-4 fw-bold">Accept all</button>
            </div>
        </div>
    </div>

    <form runat="server">
        <asp:ScriptManager runat="server" EnablePageMethods="true">
            <Scripts>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg sticky-top shadow-sm gg-nav" data-bs-theme="dark">
            <div class="container-fluid">
                <!-- Brand / Home -->
                <a class="navbar-brand p-0" runat="server" href="~/HomeRouter.aspx">
                    <img runat="server" src="~/Content/The Giant Group Logo .png" alt="The Giant Group" style="height: 40px; width: auto;" />
                </a>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Links -->
                <div class="collapse navbar-collapse" id="navbarColor01">
                    <!-- Left-Hand Side: Dynamic Menu Navigation -->
                    <ul class="navbar-nav me-auto">
                        <% if (CanSeeCalendar()) { %>
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/Calendar.aspx">Calendar</a>
                        </li>

                        <% } %>
                        
                    <!-- Public Gallery -->
                             <li class="nav-item">
                              <a class="nav-link" runat="server" href="~/Gallery/Gallery.aspx">
                                Gallery
                                  </a>
                                 </li>
                            






                        <!-- Owner only: Clients and Job Requests grouped into one menu to save space -->
                        <% if (IsOwner()) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Clients &amp; Requests</a>
                            <div class="dropdown-menu">
                                <h6 class="dropdown-header">Clients</h6>
                                <a class="dropdown-item" runat="server" href="~/ClientProfile.aspx"><i class="bi bi-person-gear me-2"></i>Update Client Info</a>
                                <div class="dropdown-divider my-1"></div>
                                <h6 class="dropdown-header">Job Requests</h6>
                                <a class="dropdown-item" runat="server" href="~/Requests/SubmitRequest.aspx"><i class="bi bi-file-earmark-plus me-2"></i>Submit Job Request</a>
                                <a class="dropdown-item" runat="server" href="~/Requests/ViewRequests.aspx"><i class="bi bi-file-earmark-text me-2"></i>Update Job Requests</a>
                                <a class="dropdown-item" runat="server" href="~/Requests/ViewRequests.aspx"><i class="bi bi-camera me-2"></i>Add Site Photos</a>
                            </div>
                        </li>
