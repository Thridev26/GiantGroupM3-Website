       <!-- Floating Chatbot Widget Window -->
<div id="chatbotPopup" class="card shadow-lg border-0 position-fixed bottom-0 end-0 m-4 rounded-4 overflow-hidden" style="z-index: 1070; width: 360px; max-height: 500px; display: none; margin-bottom: 90px !important;">
    <!-- Chat Header -->
    <div class="card-header text-white d-flex justify-content-between align-items-center py-3 px-4" style="background-color: #2d6a4f !important;">
        <div class="d-flex align-items-center">
            <span class="me-2">💬</span>
            <h6 class="fw-bold mb-0">Giant Group Assistant</h6>
        </div>
        <button type="button" class="btn text-white p-0 shadow-none border-0 fw-bold" style="font-size: 1.2rem; line-height: 1;" onclick="toggleChatbot()">&times;</button>
    </div>
    
    <!-- Chat Body / Messages Area -->
    <div class="card-body bg-light p-3 overflow-auto" style="height: 320px;" id="chatBody">
        <div class="d-flex mb-3">
            <div class="p-3 bg-white rounded-3 shadow-sm text-dark small" style="max-width: 80%;">
                👋 Hello! Welcome to Giant Tree Felling. How can we help you with your tree or garden services today?
            </div>
        </div>
    </div>

    <!-- Chat Footer / Input Form -->
    <div class="card-footer bg-white border-0 p-3">
        <div class="input-group">
            <input type="text" id="chatInput" class="form-control form-control-sm bg-light border-0 py-2 px-3" placeholder="Type your message..." />
            <button class="btn btn-success px-3" type="button" style="background-color: #2d6a4f !important; border: none;" onclick="sendChatMessage()">
                ➤
            </button>
        </div>
    </div>
</div>

<script>
    function toggleChatbot() {
        var chatPopup = document.getElementById("chatbotPopup");
        if (chatPopup) {
            if (chatPopup.style.display === "none" || chatPopup.style.display === "") {
                chatPopup.style.display = "block";
                document.getElementById("chatInput").focus();
            } else {
                chatPopup.style.display = "none";
            }
        }
    }

    function sendChatMessage() {
        var input = document.getElementById("chatInput");
        var chatBody = document.getElementById("chatBody");

        if (input.value.trim() !== "") {
            var userMsgDiv = document.createElement("div");
            userMsgDiv.className = "d-flex justify-content-end mb-3";
            userMsgDiv.innerHTML = '<div class="p-3 text-white rounded-3 shadow-sm small" style="max-width: 80%; background-color: #2d6a4f;">' + input.value + '</div>';
            chatBody.appendChild(userMsgDiv);

            var userText = input.value;
            input.value = "";
            chatBody.scrollTop = chatBody.scrollHeight;

            setTimeout(function () {
                var botMsgDiv = document.createElement("div");
                botMsgDiv.className = "d-flex mb-3";
                botMsgDiv.innerHTML = '<div class="p-3 bg-white rounded-3 shadow-sm text-dark small" style="max-width: 80%;">Thanks for reaching out! One of our team members will review your message regarding "' + userText + '" shortly. You can also call us directly at 0848 331 373.</div>';
                chatBody.appendChild(botMsgDiv);
                chatBody.scrollTop = chatBody.scrollHeight;
            }, 1000);
        }
    }
</script>

        <!-- Main Content Area -->
        <div id="main-content" class="container body-content mt-4">
            <!-- Large Floating Guest Prompt Card in Bottom-Right Corner -->
<% if (!IsLoggedIn()) { %>
     <div id="guestNoticeCard" class="card shadow-lg border-0 position-fixed bottom-80 end-0 m-4 p-4" style="z-index: 1050; bottom: 100px; background-color: #e9f5f0; color: #2d6a4f; border-left: 6px solid #40916c !important; border-radius: 12px; max-width: 420px; display: none;">
         <div class="d-flex justify-content-between align-items-start mb-2">
    <h5 class="fw-bold mb-0">Welcome to The Giant Group!</h5>
    <button type="button" class="btn border-0 p-0 shadow-none fw-bold" style="color: #2d6a4f !important; font-size: 1.4rem; line-height: 0.8;" aria-label="Close" onclick="dismissGuestCard()">&times;</button>
</div>
         <p class="mb-0 small">You are currently browsing as a guest. To access management tools, view records, or perform actions, please <a href="~/Account/Login.aspx" runat="server" class="fw-bold text-success">Log In</a> or <a href="~/Account/Register.aspx" runat="server" class="fw-bold text-success">Register</a>.</p>
     </div>

     <script>
         // Check session storage on load so it stays closed if dismissed earlier
         document.addEventListener("DOMContentLoaded", function () {
             if (!sessionStorage.getItem("guestCardDismissed")) {
                 var card = document.getElementById("guestNoticeCard");
                 if (card) {
                     card.style.display = "block";
                 }
             }
         });

         // Function triggered when the X button is clicked
         function dismissGuestCard() {
             var card = document.getElementById("guestNoticeCard");
             if (card) {
                 card.style.display = "none";
                 sessionStorage.setItem("guestCardDismissed", "true");
             }
         }
     </script>
<% } %>

            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
        </div> <!-- Closes your main container/wrapper -->
  

    <!-- Footer now sits outside the container, spanning full width -->
    <footer class="border-top bg-light text-muted py-4 mt-auto shadow-sm w-100">
        <div class="container">
            <div class="row align-items-center gy-3">
                
                <!-- Left: Company & Team Branding -->
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-1 fw-semibold text-dark small">
                        &copy; <%: DateTime.Now.Year %> The Giant Group &bull; Engineered by <span class="text-success fw-bold">Code Crusaders</span>
                    </p>
                    <p class="mb-0 text-muted" style="font-size: 0.8rem;">
                        Enterprise Operations & Asset Management System &bull; Last Updated: <span id="lastUpdatedDate" class="fw-medium text-dark"></span>
                    </p>
                </div>

                <!-- Right: Quick Navigation & Legal Links -->
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex justify-content-center justify-content-md-end align-items-center gap-3 small">
                        <a runat="server" href="~/Default.aspx" class="text-decoration-none text-muted hover-success">Home</a>
                        <span class="text-muted opacity-50">/</span>
                        <a runat="server" href="~/Help.aspx" class="text-decoration-none text-muted hover-success">Help Guide</a>
                        <span class="text-muted opacity-50">/</span>
                        <a runat="server" href="~/Contact.aspx" class="text-decoration-none text-muted hover-success">Support</a>
                        <span class="text-muted opacity-50">/</span>
                        <a runat="server" href="~/Privacy.aspx" class="text-decoration-none text-success fw-bold">Privacy Policy</a>
                    </div>
                </div>

            </div>
        </div>
    </footer>
</form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/bootstrap.js") %>
    </asp:PlaceHolder>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- AOS Animation JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <script>
        // Record exact load time
        const loaderStartTime = Date.now();
        const MINIMUM_SHOW_TIME = 900;

        AOS.init({
            duration: 800,
            once: true
        });

        // Hide 3D Loader
        window.addEventListener('load', function () {
            const loader = document.getElementById('loader-wrapper');
            if (loader) {
                const elapsedTime = Date.now() - loaderStartTime;
                const remainingTime = Math.max(0, MINIMUM_SHOW_TIME - elapsedTime);

                setTimeout(() => {
                    loader.style.opacity = '0';
                    loader.style.pointerEvents = 'none';
                    setTimeout(() => {
                        loader.style.display = 'none';
                    }, 500);
                }, remainingTime);
            }
        });

        // Show loader on navigation
        document.addEventListener('click', function (e) {
            const target = e.target.closest('a');
            if (target) {
                const rawHref = target.getAttribute('href');
                if (target.classList.contains('dropdown-toggle') || rawHref === '#' || rawHref.startsWith('javascript')) {
                    return;
                }
                if (target.href && !target.href.includes('#')) {
                    const loader = document.getElementById('loader-wrapper');
                    if (loader) {
                        loader.style.display = 'flex';
                        loader.style.opacity = '1';
                        loader.style.pointerEvents = 'auto';
                    }
                }
            }
        });

        // Global 3D Tilt Effect
        document.querySelectorAll('.tilt-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateX = -((y - centerY) / centerY) * 12;
                const rotateY = ((x - centerX) / centerX) * 12;

                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
            });

            card.addEventListener('mouseleave', () => {
                card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
                card.style.transition = 'transform 0.5s ease';
            });

            card.addEventListener('mouseenter', () => {
                card.style.transition = 'none';
            });
        });

        // --- UX FEATURES INTEGRATION ---

        // 1. Dark Mode Toggle
        const darkModeToggle = document.getElementById('darkModeToggle');
        const darkModeIcon = document.getElementById('darkModeIcon');
        const currentTheme = localStorage.getItem('theme');

        if (currentTheme === 'dark') {
            document.body.classList.add('dark-mode');
            if (darkModeIcon) darkModeIcon.className = 'bi bi-sun-fill small';
        }

        if (darkModeToggle) {
            darkModeToggle.addEventListener('click', () => {
                document.body.classList.toggle('dark-mode');
                let theme = 'light';

                if (document.body.classList.contains('dark-mode')) {
                    theme = 'dark';
                    if (darkModeIcon) darkModeIcon.className = 'bi bi-sun-fill small'; // Sun icon for dark mode
                } else {
                    if (darkModeIcon) darkModeIcon.className = 'bi bi-moon-fill small'; // Moon icon for light mode
                }

                localStorage.setItem('theme', theme);
            });
        }

        // 2. Scroll Progress Bar & Back to Top Button
        const scrollProgress = document.getElementById('scroll-progress');
        const backToTopBtn = document.getElementById('backToTopBtn');

        window.addEventListener('scroll', () => {
            const totalHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const progress = (window.scrollY / totalHeight) * 100;
            if (scrollProgress) scrollProgress.style.width = progress + '%';

            if (backToTopBtn) {
                if (window.scrollY > 300) {
                    backToTopBtn.style.display = 'block';
                } else {
                    backToTopBtn.style.display = 'none';
                }
            }
        });

        if (backToTopBtn) {
            backToTopBtn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // 3. Cookie Consent Banner Logic (Accept All / Reject Non-Essential)
        const cookieBanner = document.getElementById('cookieConsentBanner');
        const btnAccept = document.getElementById('btnAcceptCookies');
        const btnReject = document.getElementById('btnRejectCookies');

        // Helper to check cookie by name
        function getCookie(name) {
            let match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            if (match) return match[2];
            return null;
        }

        // Show banner if no choice has been recorded yet
        if (!getCookie("GiantGroupCookieConsent") && cookieBanner) {
            cookieBanner.style.display = 'block';
        }

        // Handle "Accept All"
        if (btnAccept && cookieBanner) {
            btnAccept.addEventListener('click', () => {
                document.cookie = "GiantGroupCookieConsent=Accepted; path=/; max-age=" + (60 * 60 * 24 * 365) + "; SameSite=Lax";
                cookieBanner.style.display = 'none';
            });
        }

        // Handle "Reject Non-Essential"
        if (btnReject && cookieBanner) {
            btnReject.addEventListener('click', () => {
                document.cookie = "GiantGroupCookieConsent=Rejected; path=/; max-age=" + (60 * 60 * 24 * 365) + "; SameSite=Lax";
                cookieBanner.style.display = 'none';
            });
        }

        // 4. Last Updated Date in Footer
        const lastUpdatedSpan = document.getElementById('lastUpdatedDate');
        if (lastUpdatedSpan) {
            lastUpdatedSpan.textContent = document.lastModified;
        }

        // 5. UTM Tracking Capture
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const utmSource = urlParams.get('utm_source');
            const utmMedium = urlParams.get('utm_medium');
            const utmCampaign = urlParams.get('utm_campaign');
            if (utmSource) {
                localStorage.setItem('utm_source', utmSource);
                localStorage.setItem('utm_medium', utmMedium);
                localStorage.setItem('utm_campaign', utmCampaign);
            }
        });

        // 6. Site Search Quick Filter
        const searchBtn = document.getElementById('siteSearchBtn');
        const searchInput = document.getElementById('siteSearchInput');
        if (searchBtn && searchInput) {
            const performSearch = () => {
                const query = searchInput.value.trim().toLowerCase();
                if (query) {
                    if (window.find) {
                        window.find(query);
                    } else {
                        alert("Search query: " + query);
                    }
                }
            };
            searchBtn.addEventListener('click', performSearch);
            searchInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    performSearch();
                }
            });
        }

        // 7. Password Visibility Toggle
        document.querySelectorAll('input[type="password"]').forEach(passwordField => {
            if (!passwordField.parentNode.classList.contains('input-group')) {
                const wrapper = document.createElement('div');
                wrapper.className = 'input-group';
                passwordField.parentNode.insertBefore(wrapper, passwordField);
                wrapper.appendChild(passwordField);

                const toggleBtn = document.createElement('button');
                toggleBtn.className = 'btn btn-outline-secondary';
                toggleBtn.type = 'button';
                toggleBtn.textContent = '👁️';
                toggleBtn.title = 'Show/Hide Password';
                wrapper.appendChild(toggleBtn);

                toggleBtn.addEventListener('click', () => {
                    if (passwordField.type === 'password') {
                        passwordField.type = 'text';
                        toggleBtn.textContent = '🔒︎';
                    } else {
                        passwordField.type = 'password';
                        toggleBtn.textContent = '👁️';
                    }
                });
            }
        });
    </script>

    <script>
        function toggleChatbot() {
            var chatPopup = document.getElementById("chatbotPopup");
            if (chatPopup) {
                if (chatPopup.style.display === "none" || chatPopup.style.display === "") {
                    chatPopup.style.display = "block";
                    document.getElementById("chatInput").focus();
                } else {
                    chatPopup.style.display = "none";
                }
            }
        }

        function sendChatMessage() {
            var input = document.getElementById("chatInput");
            var chatBody = document.getElementById("chatBody");
            var userText = input.value.trim();

            if (userText !== "") {
                // 1. Append user message
                var userMsgDiv = document.createElement("div");
                userMsgDiv.className = "d-flex justify-content-end mb-3";
                userMsgDiv.innerHTML = '<div class="p-3 bg-success text-white rounded-3 shadow-sm small" style="max-width: 80%;">' + escapeHtml(userText) + '</div>';
                chatBody.appendChild(userMsgDiv);

                input.value = "";
                chatBody.scrollTop = chatBody.scrollHeight;

                // 2. Simulated automated response with keyword matching after a brief delay
                setTimeout(function () {
                    var botReply = getSmartFAQResponse(userText);

                    var botMsgDiv = document.createElement("div");
                    botMsgDiv.className = "d-flex mb-3";
                    botMsgDiv.innerHTML = '<div class="p-3 bg-white rounded-3 shadow-sm text-dark small" style="max-width: 80%;">' + botReply + '</div>';
                    chatBody.appendChild(botMsgDiv);
                    chatBody.scrollTop = chatBody.scrollHeight;
                }, 600);
            }
        }

        function getSmartFAQResponse(input) {
            const text = input.toLowerCase();

            if (text.includes('price') || text.includes('cost') || text.includes('rate') || text.includes('price')) {
                return "Our pricing depends on the size and complexity of the tree-felling job. Contact us for a free on-site quote!";
            }
            else if (text.includes('hours') || text.includes('open') || text.includes('time') || text.includes('working')) {
                return "We operate Monday to Saturday, from 7:00 AM to 5:00 PM.";
            }
            else if (text.includes('contact') || text.includes('phone') || text.includes('call') || text.includes('email')) {
                return "You can reach us directly via our Contact page or call our support line at 0848 331 373.";
            }
            else if (text.includes('service') || text.includes('tree') || text.includes('felling') || text.includes('garden')) {
                return "We specialize in professional tree-felling, stump removal, site clearance, and general garden maintenance.";
            }
            else {
                return "Thanks for reaching out! One of our team members will review your message shortly. You can also call us directly at 0848 331 373.";
            }
        }

        // Helper to prevent basic HTML injection
        function escapeHtml(text) {
            var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function (m) { return map[m]; });
        }
    </script>

    <script>
        window.addEventListener('pageshow', function (event) {
            // If the page was loaded from the browser cache (back/forward button), hide the loader immediately
            if (event.persisted) {
                var loader = document.getElementById('loader-wrapper') || document.querySelector('.loader');
                if (loader) {
                    loader.style.display = 'none';
                }
            }
        });
    </script>

</body>
</html>