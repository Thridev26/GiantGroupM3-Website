                                <a class="dropdown-item" runat="server" href="~/RequestQuote.aspx"><i class="bi bi-file-earmark-plus me-2"></i>Request Quote</a>
                                <% } %>

                                <!-- Staff Create/Edit Quote -->
                                <% if (CanSeeCreateEditQuote()) { %>
                                <%--<a class="dropdown-item" runat="server" href="~/Quotes/CreateQuote.aspx"><i class="bi bi-plus-circle me-1"></i> Create Quote</a>--%>
                                <a class="dropdown-item" runat="server" href="~/ViewQuote.aspx"><i class="bi bi-pencil me-2"></i>Edit Quote</a>
                                <% } %>

