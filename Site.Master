                                <i id="darkModeIcon" class="bi bi-moon-fill small"></i>
                            </button>
                        </li>

                        <!-- Authentication -->
                        <asp:LoginView runat="server" ViewStateMode="Disabled">
                            <AnonymousTemplate>
                                <li class="nav-item ms-lg-1"><a class="nav-link text-white" runat="server" href="~/Account/Register">Register</a></li>
                                <li class="nav-item"><a class="btn btn-sm text-white px-3 py-2 rounded-pill fw-semibold" runat="server" href="~/Account/Login" style="background-color: rgba(255,255,255,0.18);">Log In</a></li>
                            </AnonymousTemplate>
                            <LoggedInTemplate>
                                <li class="nav-item ms-lg-2 d-flex align-items-center">
                                    <span class="nav-link text-white small px-2 lh-sm text-lg-end">
                                        <span class="d-block text-white-50" style="font-size: 0.7rem;">Welcome back,</span>
                                        <span class="fw-bold"><%: Session["StaffName"] ?? Session["Username"] %></span>
                                    </span>
                                </li>
                                <li class="nav-item ms-lg-1">
                                    <asp:LinkButton runat="server" ID="BtnLogout" OnClick="BtnLogout_Click" CssClass="btn btn-sm btn-outline-light rounded-pill px-3 py-2 small fw-semibold text-white text-nowrap" CausesValidation="false">
                                        Log Out
                                    </asp:LinkButton>
