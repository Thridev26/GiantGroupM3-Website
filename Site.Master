                                <h6 class="dropdown-header">Records</h6>
                                <a class="dropdown-item" runat="server" href="~/ViewQuote.aspx"><i class="bi bi-eye me-2"></i>View Quote</a>
                                <% } %>
                            </div>
                        </li>
                        <% } %>

                        <!-- Allocation Tab -->
