    </a>

</div>

   <!-- Cookie Consent Banner -->
<div id="cookieConsentBanner" class="position-fixed bottom-0 start-0 end-0 bg-dark text-white p-3 shadow-lg border-top border-success border-3" style="z-index: 1040; display: none;">
    <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
